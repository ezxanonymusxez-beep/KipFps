--// STRETCHED
local function updateStretch()
    if stretchConn then stretchConn:Disconnect(); stretchConn = nil end
    if not stretchEnabled then return end
    stretchConn = RunService.RenderStepped:Connect(function()
        cam.CFrame = cam.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, 0.75, 0, 0, 0, 1) 
    end) 
end

--// FPS BOOSTER - COLORI PERFETTI (LUMINOSIDAD REDUCIDA)
local function applyFPS()
    if not fpsEnabled then return end
    
    local cc = Instance.new("ColorCorrectionEffect", Lighting)
    
    -- LUMINOSIDAD REDUCIDA PARA MEJOR DIFERENCIACIÓN DE OBJETOS
    cc.Brightness = -0.05        -- Antes: 0.03 | Ahora: -0.05 (más oscuro)
    cc.Contrast = 0.15           -- Antes: 0.08 | Ahora: 0.15 (más contraste)
    cc.Saturation = 0.25         -- Antes: 0.35 | Ahora: 0.25 (menos saturado)
    cc.TintColor = Color3.fromRGB(245, 245, 240)  -- Antes: 255,252,250 | Ahora más neutro
    
    -- Iluminación ambiental reducida
    Lighting.Ambient = Color3.fromRGB(180, 180, 180)        -- Antes: 220,220,220
    Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 195) -- Antes: 240,235,235
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    
    pcall(function() 
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 
    end)
    
    local function optimize(o)
        if o:IsA("BasePart") then 
            o.Material = Enum.Material.SmoothPlastic 
            o.Reflectance = 0 
            o.CastShadow = false
        elseif o:IsA("ParticleEmitter") or o:IsA("Trail") then
            o.Enabled = false
        elseif o:IsA("Decal") or o:IsA("Texture") then
            o.Transparency = 1
        end
    end
    
    Workspace.DescendantAdded:Connect(optimize)
    for _, v in pairs(Workspace:GetDescendants()) do optimize(v) end
end

